# Copiez ce fichier en .env.local (jamais versionné) et renseignez les valeurs.
# Supabase : Project Settings → API Keys (ou « Connect » en haut du tableau de bord).

# Adresse du projet Supabase (publique).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé « publishable » (sb_publishable_…) ou ancienne clé « anon » : publique par conception, protégée par les règles RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Adresse publique du site (liens des e-mails). Ex. : https://devis-scan.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets serveur : NE JAMAIS préfixer par NEXT_PUBLIC_, ne jamais versionner ---
# Clé secrète (sb_secret_…) : tâches système uniquement (purge des vidéos, envois signés du parcours client).
SUPABASE_SECRET_KEY=
# Secret partagé avec Vercel Cron pour la purge automatique des vidéos (32 caractères aléatoires ou plus).
CRON_SECRET=

# --- Analyse IA (phase 4), serveur uniquement ---
# Vide = aucune analyse automatique (aucune dépense). « anthropic » = analyse réelle, facturée par Anthropic.
AI_PROVIDER=
# Clé API Anthropic (console.anthropic.com → API Keys). Secret : jamais dans le code ni dans GitHub.
# Nom imposé : DEVIS_SCAN_ANTHROPIC_API_KEY (ANTHROPIC_API_KEY n'est jamais lue par le projet).
DEVIS_SCAN_ANTHROPIC_API_KEY=
# Modèle OBLIGATOIRE (claude-haiku-5-5, claude-sonnet-5-5 ou claude-opus-5-5), choisi d'après tests/ai-eval ; effort (low, medium, high).
AI_MODEL=
AI_EFFORT=
# Tests locaux uniquement : AI_PROVIDER=simulation et AI_ALLOW_SIMULATION=1 (refusé hors base locale et sur Vercel).
AI_ALLOW_SIMULATION=
